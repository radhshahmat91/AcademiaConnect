# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB connection string.
# Local install:      mongodb://127.0.0.1:27017/academiaconnect
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/academiaconnect
MONGO_URI=mongodb://127.0.0.1:27017/academiaconnect

# Any long, random string. Used to sign login tokens.
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session lasts before the user must log in again.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=5000

# The URL your React frontend runs on. Used for CORS.
CLIENT_URL=http://localhost:5173

# What environment this is running in.
NODE_ENV=development
